#!/usr/bin/env bash
set -euo pipefail

WT_FREE_PREFIX="${WT_FREE_PREFIX:-free-}"
WT_REPO_URL="${WT_REPO_URL:-https://github.com/tomergalatwix/wt.git}"
WT_REPO_REF="${WT_REPO_REF:-master}"
WT_REPO_RAW_ROOT="${WT_REPO_RAW_ROOT:-https://raw.githubusercontent.com/tomergalatwix/wt}"
WT_REPO_RAW_BASE="${WT_REPO_RAW_BASE:-}"
WT_CACHE_TTL="${WT_CACHE_TTL:-10}"

die() {
  if color_enabled; then
    printf '\033[31mError: %s\033[0m\n' "$*" >&2
  else
    printf 'Error: %s\n' "$*" >&2
  fi
  exit 1
}

color_enabled() {
  [[ "${WT_COLOR:-1}" != "0" && -z "${NO_COLOR:-}" ]]
}

info() {
  if color_enabled; then
    printf '\033[36m%s\033[0m\n' "$*"
  else
    printf '%s\n' "$*"
  fi
}

phase() {
  if color_enabled; then
    printf '\n\033[1;36m%s\033[0m\n' "$*"
  else
    printf '\n%s\n' "$*"
  fi
}

output_header() {
  if color_enabled; then
    printf '\033[2;36mOutput:\033[0m\n'
  else
    printf 'Output:\n'
  fi
}

show_truncated_output() {
  local file="$1"
  local lines
  lines="$(wc -l <"$file" | tr -d ' ')"

  output_header
  if [[ ! -s "$file" ]]; then
    printf '(none)\n'
  elif ((lines > 3)); then
    printf '...\n'
    tail -n 3 "$file"
  else
    cat "$file"
  fi
  printf '\n'
}

run_logged() {
  local label="$1"
  shift
  local tmp status
  tmp="$(mktemp -t wt-output.XXXXXX)" || return $?

  phase "$label"
  if "$@" >"$tmp" 2>&1; then
    status=0
  else
    status=$?
  fi

  show_truncated_output "$tmp"
  rm -f "$tmp"
  return "$status"
}

run_logged_in_dir() {
  local label="$1"
  local dir="$2"
  shift 2
  local tmp status
  tmp="$(mktemp -t wt-output.XXXXXX)" || return $?

  phase "$label"
  if (cd "$dir" && "$@") >"$tmp" 2>&1; then
    status=0
  else
    status=$?
  fi

  show_truncated_output "$tmp"
  rm -f "$tmp"
  return "$status"
}

print_dirty_files() {
  local wt="$1"
  info "Changed files:"
  git -C "$wt" status --short
}

discard_worktree_changes() {
  local repo="$1"
  local wt="$2"

  info "Discarding dirty worktree changes before reuse."
  run_logged "Resetting tracked changes..." \
    git_wt "$repo" -C "$wt" reset --hard
  run_logged "Removing untracked files..." \
    git_wt "$repo" -C "$wt" clean -fd
}

ensure_clean_for_reuse() {
  local repo="$1"
  local wt="$2"
  local force="$3"
  local prompt="$4"
  local consequence="$5"

  if [[ -z "$(git -C "$wt" status --porcelain)" ]]; then
    info "Worktree is clean."
    return 0
  fi

  print_dirty_files "$wt"
  if ((force == 1)); then
    info "Worktree is dirty; discarding changes because --force/-f was provided."
  elif [[ -t 0 ]]; then
    local answer
    info "$consequence"
    read -r -p "$prompt [y/N] " answer
    [[ "$answer" == [yY] || "$answer" == [yY][eE][sS] ]] || {
      info "Cancelled."
      return 1
    }
    info "Worktree is dirty; discarding changes by confirmation."
  else
    die "Worktree has uncommitted changes. Re-run with --force or -f to discard them and continue."
  fi

  discard_worktree_changes "$repo" "$wt"
  info "Worktree is clean."
}

main_lefthook_bin() {
  local repo="$1"
  local candidate
  for candidate in \
    "$repo/node_modules/.bin/lefthook" \
    "$repo/node_modules/lefthook/bin/index.js" \
    "$repo/node_modules/lefthook-$(uname | tr '[:upper:]' '[:lower:]')-$(uname -m | sed 's/aarch64/arm64/;s/x86_64/x64/')/bin/lefthook"; do
    [[ -x "$candidate" || -f "$candidate" ]] && {
      printf '%s\n' "$candidate"
      return 0
    }
  done
  return 1
}

git_wt() {
  local repo="$1"
  shift
  local lefthook_bin
  if lefthook_bin="$(main_lefthook_bin "$repo")"; then
    LEFTHOOK_BIN="$lefthook_bin" git "$@"
  else
    LEFTHOOK=0 git -c core.hooksPath=/dev/null "$@"
  fi
}

hook_strategy() {
  local repo="$1"
  local lefthook_bin
  if lefthook_bin="$(main_lefthook_bin "$repo")"; then
    printf 'using main checkout lefthook: %s\n' "$lefthook_bin"
  else
    printf 'disabled; no lefthook found in main checkout\n'
  fi
}

repo_root() {
  local common_dir
  common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || die "Run this command from inside a git repository."

  if [[ "$(basename "$common_dir")" == ".git" ]]; then
    dirname "$common_dir"
  else
    git rev-parse --show-toplevel 2>/dev/null || die "Run this command from inside a git repository."
  fi
}

default_base_ref() {
  local repo="$1"
  local remote_ref
  remote_ref="$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"

  if [[ -n "$remote_ref" ]] && git -C "$repo" show-ref --verify --quiet "refs/remotes/$remote_ref"; then
    echo "$remote_ref"
  elif git -C "$repo" show-ref --verify --quiet refs/remotes/origin/master; then
    echo "origin/master"
  elif git -C "$repo" show-ref --verify --quiet refs/remotes/origin/main; then
    echo "origin/main"
  elif git -C "$repo" show-ref --verify --quiet refs/heads/master; then
    echo "master"
  elif git -C "$repo" show-ref --verify --quiet refs/heads/main; then
    echo "main"
  else
    echo "HEAD"
  fi
}

fresh_default_ref() {
  local repo="$1"
  local branch=""
  local remote_ref

  if git -C "$repo" remote get-url origin >/dev/null 2>&1; then
    remote_ref="$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    if [[ "$remote_ref" == origin/* ]]; then
      branch="${remote_ref#origin/}"
    elif git -C "$repo" show-ref --verify --quiet refs/remotes/origin/master; then
      branch="master"
    elif git -C "$repo" show-ref --verify --quiet refs/remotes/origin/main; then
      branch="main"
    fi

    if [[ -n "$branch" ]] &&
      run_logged "Updating $branch from origin..." git_wt "$repo" -C "$repo" fetch --prune origin "$branch" >&2 &&
      git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      echo "origin/$branch"
      return 0
    fi
  fi

  for branch in master main; do
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
      echo "$branch"
      return 0
    fi
  done

  die "Could not refresh origin default branch and local master/main does not exist."
}

pool_dir() {
  local repo="$1"
  if [[ -n "${WT_POOL_DIR:-}" ]]; then
    echo "$WT_POOL_DIR"
  else
    echo "$(dirname "$repo")/$(basename "$repo")-worktrees"
  fi
}

is_detached() {
  local wt="$1"
  ! git -C "$wt" symbolic-ref --quiet HEAD >/dev/null 2>&1
}

is_clean() {
  local wt="$1"
  [[ -z "$(git -C "$wt" status --porcelain)" ]]
}

branch_name() {
  local wt="$1"
  git -C "$wt" symbolic-ref --quiet --short HEAD 2>/dev/null || echo "(detached HEAD)"
}

stat_mtime() {
  local path="$1"
  if stat -f %m "$path" >/dev/null 2>&1; then
    stat -f %m "$path"
  else
    stat -c %Y "$path"
  fi
}

format_mtime() {
  local epoch="$1"
  if date -r "$epoch" "+%Y-%m-%d %H:%M" >/dev/null 2>&1; then
    date -r "$epoch" "+%Y-%m-%d %H:%M"
  else
    date -d "@$epoch" "+%Y-%m-%d %H:%M"
  fi
}

wt_name() {
  local repo="$1"
  local wt="$2"
  if [[ "$wt" == "$repo" ]]; then
    echo "main"
  else
    basename "$wt"
  fi
}

relative_from_epoch() {
  local epoch="$1"
  local now diff value unit
  now="$(date +%s)"
  diff=$((now - epoch))
  ((diff < 0)) && diff=0

  if ((diff < 10)); then
    echo "just now"
    return 0
  elif ((diff < 60)); then
    value=$diff
    unit="sec"
  elif ((diff < 3600)); then
    value=$((diff / 60))
    unit="min"
  elif ((diff < 86400)); then
    value=$((diff / 3600))
    unit="hour"
  elif ((diff < 604800)); then
    value=$((diff / 86400))
    unit="day"
  elif ((diff < 2592000)); then
    value=$((diff / 604800))
    unit="week"
  elif ((diff < 31536000)); then
    value=$((diff / 2592000))
    unit="month"
  else
    value=$((diff / 31536000))
    unit="year"
  fi

  if ((value == 1)); then
    echo "1 $unit ago"
  else
    echo "$value ${unit}s ago"
  fi
}

install_command_for() {
  local wt="$1"
  if [[ -f "$wt/yarn.lock" ]]; then
    command -v yarn >/dev/null 2>&1 && echo "yarn install"
  elif [[ -f "$wt/pnpm-lock.yaml" ]]; then
    command -v pnpm >/dev/null 2>&1 && echo "pnpm install"
  elif [[ -f "$wt/package-lock.json" ]]; then
    command -v npm >/dev/null 2>&1 && echo "npm install"
  fi
  return 0
}

lockfile_for() {
  local wt="$1"
  if [[ -f "$wt/yarn.lock" ]]; then
    echo "yarn.lock"
  elif [[ -f "$wt/pnpm-lock.yaml" ]]; then
    echo "pnpm-lock.yaml"
  elif [[ -f "$wt/package-lock.json" ]]; then
    echo "package-lock.json"
  fi
  return 0
}

fzf_command() {
  local fzf_cmd="${WT_FZF_COMMAND:-fzf}"
  command -v "$fzf_cmd" >/dev/null 2>&1 || die "fzf is required for interactive wt. Install with: brew install fzf"
  echo "$fzf_cmd"
}

download_file() {
  local url="$1"
  local dest="$2"

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$url" -o "$dest"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$dest" "$url"
  else
    die "curl or wget is required."
  fi
}

resolve_repo_ref() {
  if [[ "$WT_REPO_REF" =~ ^[0-9a-fA-F]{40}$ ]]; then
    printf '%s\n' "$WT_REPO_REF"
    return 0
  fi

  local sha
  sha="$(git ls-remote "$WT_REPO_URL" "refs/heads/$WT_REPO_REF" 2>/dev/null | awk '{ print $1; exit }')"
  [[ -n "$sha" ]] || die "Could not resolve $WT_REPO_REF from $WT_REPO_URL. Set WT_REPO_RAW_BASE to install from a custom source."
  printf '%s\n' "$sha"
}

repo_raw_base() {
  if [[ -n "$WT_REPO_RAW_BASE" ]]; then
    printf '%s\n' "$WT_REPO_RAW_BASE"
  else
    printf '%s/%s\n' "$WT_REPO_RAW_ROOT" "$(resolve_repo_ref)"
  fi
}

all_pool_worktrees() {
  local repo="$1"
  local pool="$2"
  all_worktrees "$repo" |
    while IFS= read -r d; do
      [[ "$d" == "$pool"/* ]] && printf '%s\n' "$d"
    done | sort
}

all_worktree_records() {
  local repo="$1"
  git_wt "$repo" -C "$repo" worktree list --porcelain |
    awk -v repo="$repo" '
      function emit() {
        if (path == "") {
          return
        }
        name = path
        sub(/^.*\//, "", name)
        if (path == repo) {
          name = "main"
        }
        if (branch == "") {
          branch = "(detached HEAD)"
        }
        sub(/^refs\/heads\//, "", branch)
        print path "|" branch "|" name
      }
      /^worktree / {
        emit()
        path = substr($0, 10)
        branch = ""
        next
      }
      /^branch / {
        branch = substr($0, 8)
        next
      }
      /^detached$/ {
        branch = "(detached HEAD)"
        next
      }
      END {
        emit()
      }
    ' |
    sort
}

all_worktrees() {
  local repo="$1"
  all_worktree_records "$repo" | cut -d'|' -f1
}

status_jobs() {
  local jobs="${WT_STATUS_JOBS:-6}"
  if [[ ! "$jobs" =~ ^[0-9]+$ || "$jobs" -lt 1 ]]; then
    jobs=6
  fi
  printf '%s\n' "$jobs"
}

worktree_status_records() {
  (($# > 0)) || return 0

  local jobs
  jobs="$(status_jobs)"
  printf '%s\0' "$@" |
    xargs -0 -n 1 -P "$jobs" sh -c '
      wt=$1
      if tracked=$(git -C "$wt" status --porcelain --untracked-files=no 2>/dev/null) && [ -n "$tracked" ]; then
        status=dirty
      elif output=$(git -C "$wt" ls-files --others --exclude-standard --directory --no-empty-directory 2>/dev/null); then
        if [ -n "$output" ]; then
          status=dirty
        else
          status=clean
        fi
      else
        status=unknown
      fi
      printf "%s\t%s\n" "$wt" "$status"
    ' sh
}

cache_ttl() {
  local ttl="$WT_CACHE_TTL"
  if [[ ! "$ttl" =~ ^[0-9]+$ ]]; then
    ttl=10
  fi
  printf '%s\n' "$ttl"
}

cache_dir() {
  printf '%s/wt\n' "${XDG_CACHE_HOME:-$HOME/.cache}"
}

cache_key() {
  local value="$1"
  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$value" | shasum -a 1 | awk '{ print $1 }'
  else
    printf '%s' "$value" | cksum | awk '{ print $1 }'
  fi
}

worktree_rows_cache_file() {
  local repo="$1"
  printf '%s/%s.rows\n' "$(cache_dir)" "$(cache_key "$repo")"
}

clear_worktree_rows_cache() {
  local repo="$1"
  rm -f "$(worktree_rows_cache_file "$repo")"
}

worktree_rows_uncached() {
  local repo="$1"
  local records=()
  local paths=()
  local record path rest branch name

  while IFS= read -r record; do
    [[ -n "$record" ]] || continue
    records+=("$record")
    path="${record%%|*}"
    paths+=("$path")
  done < <(all_worktree_records "$repo")

  local statuses=()
  local status_line
  if ((${#paths[@]} > 0)); then
    while IFS= read -r status_line; do
      [[ -n "$status_line" ]] || continue
      statuses+=("$status_line")
    done < <(worktree_status_records "${paths[@]}")
  fi

  for record in "${records[@]}"; do
    path="${record%%|*}"
    rest="${record#*|}"
    branch="${rest%%|*}"
    name="${rest#*|}"

    local status="unknown"
    local i status_path
    for ((i = 0; i < ${#statuses[@]}; i++)); do
      status_path="${statuses[$i]%%$'\t'*}"
      if [[ "$status_path" == "$path" ]]; then
        status="${statuses[$i]#*$'\t'}"
        break
      fi
    done

    local mtime mtime_h
    mtime="$(stat_mtime "$path")"
    mtime_h="$(relative_from_epoch "$mtime")"
    printf '%s|%s|%s|%s|%s|%s\n' "$mtime" "$name" "$status" "$mtime_h" "$branch" "$path"
  done
}

worktree_rows() {
  local repo="$1"
  local ttl file now mtime age dir tmp

  ttl="$(cache_ttl)"
  if ((ttl == 0)); then
    worktree_rows_uncached "$repo"
    return 0
  fi

  file="$(worktree_rows_cache_file "$repo")"
  if [[ -f "$file" ]]; then
    now="$(date +%s)"
    mtime="$(stat_mtime "$file")"
    age=$((now - mtime))
    if ((age >= 0 && age <= ttl)); then
      cat "$file"
      return 0
    fi
  fi

  dir="$(cache_dir)"
  mkdir -p "$dir" 2>/dev/null || {
    worktree_rows_uncached "$repo"
    return 0
  }
  tmp="$(mktemp "$dir/rows.XXXXXX")" || {
    worktree_rows_uncached "$repo"
    return 0
  }
  worktree_rows_uncached "$repo" > "$tmp"
  mv "$tmp" "$file"
  cat "$file"
}

is_free_slot_path() {
  local path="$1"
  [[ "$(basename "$path")" =~ ^${WT_FREE_PREFIX}[0-9]+$ ]]
}

next_free_slot_path() {
  local pool="$1"
  local n=1
  while :; do
    local candidate="$pool/${WT_FREE_PREFIX}${n}"
    [[ ! -e "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
    n=$((n + 1))
  done
}

pick_idle_free_slot() {
  local repo="$1"
  local pool="$2"
  local candidates=()
  local wt
  while IFS= read -r wt; do
    [[ -n "$wt" ]] || continue
    is_free_slot_path "$wt" || continue
    if is_detached "$wt" && is_clean "$wt"; then
      local num
      num="$(basename "$wt" | sed -E "s/^${WT_FREE_PREFIX}([0-9]+)$/\\1/")"
      candidates+=("$num|$wt")
    fi
  done < <(all_pool_worktrees "$repo" "$pool")

  ((${#candidates[@]} > 0)) || return 1
  printf '%s\n' "${candidates[@]}" | sort -t'|' -k1,1n | head -n1 | cut -d'|' -f2-
}

pick_worktree_target() {
  local repo="$1"
  local query="$2"
  local matches=()
  local record

  while IFS= read -r record; do
    [[ -n "$record" ]] || continue
    local wt rest branch base name
    wt="${record%%|*}"
    rest="${record#*|}"
    branch="${rest%%|*}"
    name="${rest#*|}"
    base="$(basename "$wt")"
    if [[ "$wt" == "$query" || "$branch" == *"$query"* || "$base" == *"$query"* || "$name" == *"$query"* || "$wt" == *"$query"* ]]; then
      matches+=("$wt|$branch|$name")
    fi
  done < <(all_worktree_records "$repo")

  if ((${#matches[@]} == 1)); then
    printf '%s\n' "${matches[0]%%|*}"
    return 0
  fi

  if ((${#matches[@]} > 1)); then
    info "Ambiguous match for '$query':"
    local m
    for m in "${matches[@]}"; do
      local path rest branch name
      path="${m%%|*}"
      rest="${m#*|}"
      branch="${rest%%|*}"
      name="${rest##*|}"
      printf '  %s (%s)\n' "$name" "$branch"
    done
    return 2
  fi
  return 1
}

cmd_grow() {
  local repo="$1"
  shift
  local pool
  pool="$(pool_dir "$repo")"
  local base_ref
  base_ref="$(default_base_ref "$repo")"
  local size=1
  local warm=0

  while (($#)); do
    case "$1" in
      --size)
        shift
        [[ $# -gt 0 ]] || die "--size requires a value"
        size="$1"
        ;;
      --base)
        shift
        [[ $# -gt 0 ]] || die "--base requires a value"
        base_ref="$1"
        ;;
      --warm)
        warm=1
        ;;
      *)
        die "Unknown option for grow: $1"
        ;;
    esac
    shift
  done
  [[ "$size" =~ ^[0-9]+$ && "$size" -gt 0 ]] || die "--size must be a positive integer"

  mkdir -p "$pool"
  git -C "$repo" rev-parse --verify "${base_ref}^{commit}" >/dev/null 2>&1 || die "Base ref '$base_ref' does not exist."

  info "Growing worktree pool in: $pool"
  info "Base ref: $base_ref"
  info "Adding: $size"
  info "Git hooks: $(hook_strategy "$repo")"

  local i slot
  for ((i = 1; i <= size; i++)); do
    slot="$(next_free_slot_path "$pool")"
    info "  - $(basename "$slot"): creating detached worktree at $slot"
    run_logged "Creating detached worktree $(basename "$slot")..." \
      git_wt "$repo" -C "$repo" worktree add -q --detach "$slot" "$base_ref"

    if ((warm)); then
      local install_cmd lockfile
      lockfile="$(lockfile_for "$slot")"
      install_cmd="$(install_command_for "$slot")"
      if [[ -z "$lockfile" ]]; then
        info "    deps: no supported lockfile found; skipping install"
        continue
      fi
      if [[ -z "$install_cmd" ]]; then
        info "    deps: found $lockfile, but matching package manager is not in PATH; skipping install"
        continue
      fi
      if [[ -d "$slot/node_modules" ]]; then
        info "    deps: node_modules already present; skipping $install_cmd"
      else
        info "    deps: running $install_cmd"
        run_logged_in_dir "Installing dependencies in $(basename "$slot")..." \
          "$slot" bash -c "$install_cmd"
      fi
    fi
  done
  clear_worktree_rows_cache "$repo"
}

cmd_list() {
  local repo="$1"
  shift
  while (($#)); do
    case "$1" in
      --full) ;; # kept for backward compatibility; list is always full now
      *) die "Unknown option for list: $1" ;;
    esac
    shift
  done

  local rows=()
  local row
  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    rows+=("$row")
  done < <(worktree_rows "$repo")

  local name_w=4
  local branch_w=6
  local line name branch
  for row in "${rows[@]}"; do
    line="${row#*|}"   # drop epoch
    name="${line%%|*}"
    if ((${#name} > name_w)); then
      name_w=${#name}
    fi
    line="${line#*|}"  # drop name
    line="${line#*|}"  # drop status
    line="${line#*|}"  # drop modified
    branch="${line%%|*}"
    if ((${#branch} > branch_w)); then
      branch_w=${#branch}
    fi
  done

  info "Git Worktrees for $(basename "$repo")"
  printf "%-${name_w}s  %-7s  %-16s  %-${branch_w}s\n" "NAME" "STATUS" "LAST MODIFIED" "BRANCH"

  local line
  while IFS= read -r line; do
    local name status mtime_h branch
    line="${line#*|}"            # drop epoch
    name="${line%%|*}"
    line="${line#*|}"
    status="${line%%|*}"
    line="${line#*|}"
    mtime_h="${line%%|*}"
    line="${line#*|}"
    branch="${line%%|*}"
    printf "%-${name_w}s  %-7s  %-16s  %-${branch_w}s\n" "$name" "$status" "$mtime_h" "$branch"
  done < <(printf '%s\n' "${rows[@]}" | sort -t'|' -k1,1nr)

  info "$((${#rows[@]})) worktrees total"
}

cmd_interactive() {
  local repo="$1"
  shift
  [[ $# -eq 0 ]] || die "Unknown option for interactive mode: $1"

  local fzf_cmd
  fzf_cmd="$(fzf_command)"

  local rows=()
  local row
  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    rows+=("$row")
  done < <(worktree_rows "$repo")

  local name_w=16
  local branch_w=18
  local row line name branch
  for row in "${rows[@]}"; do
    line="${row#*|}"
    name="${line%%|*}"
    if ((${#name} > name_w)); then
      name_w=${#name}
    fi
    line="${line#*|}"
    line="${line#*|}"
    line="${line#*|}"
    branch="${line%%|*}"
    if ((${#branch} > branch_w)); then
      branch_w=${#branch}
    fi
  done

  while :; do
    local selection_raw selection_key selection
    selection_raw="$(
      {
        printf "%-${name_w}s  %-7s  %-16s  %-${branch_w}s\t%s\t%s\n" "NAME" "STATUS" "LAST MODIFIED" "BRANCH" "__NAME__" "__PATH__"
        printf '%s\n' "${rows[@]}" |
          sort -t'|' -k1,1nr |
          while IFS='|' read -r _mtime _name _status _mtime_h _branch _path; do
            printf "%-${name_w}s  %-7s  %-16s  %-${branch_w}s\t%s\t%s\n" "$_name" "$_status" "$_mtime_h" "$_branch" "$_name" "$_path"
          done
        printf "%-${name_w}s  %-7s  %-16s  %-${branch_w}s\t%s\t%s\n" "Add new worktree" "" "" "" "__WT_GROW__" "__WT_GROW__"
      } |
        "$fzf_cmd" \
          --height=80% \
          --reverse \
          --expect=backspace \
          --footer='Esc: exit  |  Backspace: exit' \
          --header-lines=1 \
          --delimiter=$'\t' \
          --with-nth=1 \
          --prompt='Choose worktree> '
    )" || return 0

    selection_key=""
    selection="$selection_raw"
    if [[ "$selection_raw" == "backspace" ]]; then
      return 0
    elif [[ "$selection_raw" == *$'\n'* ]]; then
      selection_key="${selection_raw%%$'\n'*}"
      selection="${selection_raw#*$'\n'}"
    fi
    [[ "$selection_key" == "backspace" ]] && return 0
    [[ -n "$selection" ]] || return 0

    local name path action action_raw action_key action_selection actions
    name="$(awk -F $'\t' '{ print $2 }' <<<"$selection")"
    path="$(awk -F $'\t' '{ print $3 }' <<<"$selection")"
    [[ -n "$path" ]] || die "Could not resolve selected worktree path."
    if [[ "$path" == "__WT_GROW__" ]]; then
      if [[ "${WT_SHELL_INTEGRATION:-0}" == "1" ]]; then
        printf '__WT_GROW__\n'
      else
        cmd_grow "$repo"
      fi
      return 0
    fi

    actions="$(
      printf '%s\t%-18s    \033[2m%s\033[0m\n' "go" "go" "cd into this worktree"
      if [[ "$path" != "$repo" ]] && ! is_free_slot_path "$path"; then
        printf '%s\t%-18s    \033[2m%s\033[0m\n' "free" "free" "detach and return this worktree to the free pool"
        printf '%s\t%-18s    \033[2m%s\033[0m\n' "realloc" "realloc" "free this worktree and allocate another branch into it"
      fi
      if is_free_slot_path "$path"; then
        printf '%s\t%-18s    \033[2m%s\033[0m\n' "alloc" "alloc" "allocate a new/existing branch in this free worktree"
      fi
      if [[ "$path" != "$repo" ]]; then
        printf '%s\t%-18s    \033[2m%s\033[0m\n' "remove" "remove" "delete this worktree from the pool"
      fi
    )"

    action_raw="$(
      printf '%s\n' "$actions" |
        "$fzf_cmd" \
          --height=10 \
          --reverse \
          --ansi \
          --expect=backspace \
          --footer='Esc: exit  |  Backspace: back' \
          --header="Chosen worktree: $name"$'\n'"Choose action:" \
          --delimiter=$'\t' \
          --with-nth=2 \
          --prompt='> '
    )" || return 0

    action_key=""
    action_selection="$action_raw"
    if [[ "$action_raw" == "backspace" ]]; then
      continue
    elif [[ "$action_raw" == *$'\n'* ]]; then
      action_key="${action_raw%%$'\n'*}"
      action_selection="${action_raw#*$'\n'}"
    fi
    [[ "$action_key" == "backspace" ]] && continue
    action="$(awk -F $'\t' '{ print $1 }' <<<"$action_selection")"

    case "$action" in
      go)
        if [[ "${WT_SHELL_INTEGRATION:-0}" == "1" ]]; then
          printf '__WT_GO__\t%s\t%s\n' "$path" "$name"
        else
          info "$path"
          info "Run: cd $path"
        fi
        ;;
      free)
        if [[ "${WT_SHELL_INTEGRATION:-0}" == "1" ]]; then
          printf '__WT_FREE__\t%s\t%s\n' "$name" "$path"
        else
          die "Shell integration is not loaded. Run: source ~/.config/wt/wt.zsh"
        fi
        ;;
      realloc)
        if [[ "${WT_SHELL_INTEGRATION:-0}" == "1" ]]; then
          printf '__WT_REALLOC__\t%s\t%s\n' "$name" "$path"
        else
          die "Shell integration is not loaded. Run: source ~/.config/wt/wt.zsh"
        fi
        ;;
      remove)
        if [[ "${WT_SHELL_INTEGRATION:-0}" == "1" ]]; then
          printf '__WT_REMOVE__\t%s\t%s\n' "$name" "$path"
        else
          die "Shell integration is not loaded. Run: source ~/.config/wt/wt.zsh"
        fi
        ;;
      alloc)
        if [[ "${WT_SHELL_INTEGRATION:-0}" == "1" ]]; then
          printf '__WT_ALLOC__\n'
        else
          cmd_alloc "$repo"
        fi
        ;;
      "")
        return 0
        ;;
      *)
        die "Unknown action: $action"
        ;;
    esac
    return 0
  done
}

go_message() {
  local machine="$1"
  shift
  if ((machine)); then
    printf '%s
' "$*" >&2
  else
    info "$*"
  fi
}

cmd_go() {
  local repo="$1"
  shift
  local print_path=0
  local print_record=0
  local query=""
  while (($#)); do
    case "$1" in
      --print-path) print_path=1 ;;
      --print-record) print_record=1 ;;
      *) query="$1" ;;
    esac
    shift
  done
  [[ -n "$query" ]] || die "Usage: wt go <query>"

  local matches=()
  local record
  while IFS= read -r record; do
    [[ -n "$record" ]] || continue
    local wt rest branch base name
    wt="${record%%|*}"
    rest="${record#*|}"
    branch="${rest%%|*}"
    name="${rest#*|}"
    base="$(basename "$wt")"
    if [[ "$branch" == *"$query"* || "$base" == *"$query"* || "$name" == *"$query"* || "$wt" == *"$query"* ]]; then
      matches+=("$wt|$branch|$name")
    fi
  done < <(all_worktree_records "$repo")

  local machine=0
  ((print_path || print_record)) && machine=1

  if ((${#matches[@]} == 1)); then
    local path rest branch name
    path="${matches[0]%%|*}"
    rest="${matches[0]#*|}"
    branch="${rest%%|*}"
    name="${rest##*|}"
    if ((print_record)); then
      printf '%s	%s
' "$path" "$name"
    elif ((print_path)); then
      printf '%s
' "$path"
    else
      info "Found worktree $name: $path"
      info "Run: cd $path"
    fi
    return 0
  fi

  if ((${#matches[@]} > 1)); then
    local m matches_text sep
    matches_text=""
    sep=""
    for m in "${matches[@]}"; do
      local rest branch name
      rest="${m#*|}"
      branch="${rest%%|*}"
      name="${rest##*|}"
      matches_text+="${sep}${name} (${branch})"
      sep=", "
    done
    go_message "$machine" "Ambiguous worktree query '$query': $matches_text"
    return 2
  fi

  go_message "$machine" "Could not find worktree containing '$query'."
  return 1
}
alloc_branch() {
  local repo="$1"
  local pool="$2"
  local branch="$3"
  local base_ref="$4"
  local base_overridden="$5"
  local preferred_slot="${6:-}"
  local allow_dirty_slot="${7:-0}"

  [[ -n "$branch" ]] || die "Branch name is required. Usage: wt alloc <branch>"
  info "Alloc requested for branch: $branch"
  info "Pool: $pool"
  info "Git hooks: $(hook_strategy "$repo")"

  local branch_exists=0
  if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
    branch_exists=1
  fi
  if ((branch_exists == 1)); then
    info "Branch mode: existing local branch"
  else
    info "Branch mode: new local branch"
  fi

  if ((branch_exists == 1)); then
    local existing_wt
    while IFS= read -r existing_wt; do
      [[ -n "$existing_wt" ]] || continue
      if [[ "$(branch_name "$existing_wt")" == "$branch" ]]; then
        die "Branch '$branch' is already checked out at: $existing_wt"
      fi
    done < <(all_worktrees "$repo")
  fi

  local rebase_ref="$base_ref"
  if ((base_overridden == 0)); then
    info "Refreshing remote default branch..."
    rebase_ref="$(fresh_default_ref "$repo")"
    info "Remote default branch ref: $rebase_ref"
    if ((branch_exists == 0)); then
      base_ref="$rebase_ref"
    fi
  else
    info "Base override: $base_ref"
  fi

  if ((branch_exists == 0 || base_overridden == 1)); then
    git -C "$repo" rev-parse --verify "${base_ref}^{commit}" >/dev/null 2>&1 || die "Base ref '$base_ref' does not exist."
  fi

  local slot
  if [[ -n "$preferred_slot" ]]; then
    slot="$preferred_slot"
    info "Using reallocated slot: $(basename "$slot")"
    is_detached "$slot" || die "Reallocated slot is not detached: $slot"
    if ! is_clean "$slot"; then
      if ((allow_dirty_slot == 1)); then
        info "Reallocated slot is dirty; continuing because this was explicitly confirmed."
      else
        die "Reallocated slot is not clean: $slot"
      fi
    fi
  else
    info "Looking for a clean detached free-N slot..."
    slot="$(pick_idle_free_slot "$repo" "$pool")" || die "No clean detached free slot available. Free one first."
    info "Using free slot: $(basename "$slot")"
  fi
  local old_head
  old_head="$(git -C "$slot" rev-parse --verify HEAD 2>/dev/null || true)"

  local target="$pool/$branch"
  [[ ! -e "$target" ]] || die "Target worktree path already exists: $target"
  mkdir -p "$(dirname "$target")"

  info "Moving worktree: $slot -> $target"
  run_logged "Moving worktree into branch slot..." \
    git_wt "$repo" -C "$repo" worktree move "$slot" "$target"

  if ((branch_exists == 1)); then
    info "Checking out existing branch: $branch"
    run_logged "Checking out existing branch..." \
      git_wt "$repo" -C "$target" checkout --quiet "$branch"
    info "Rebasing on $rebase_ref..."
    run_logged_in_dir "Rebasing on $rebase_ref..." \
      "$target" git_wt "$repo" rebase "$rebase_ref" --autostash
  else
    info "Allocating branch $branch from $base_ref"
    run_logged "Creating branch from $base_ref..." \
      git_wt "$repo" -C "$target" checkout --quiet -b "$branch" "$base_ref"
  fi

  local install_cmd lockfile
  install_cmd="$(install_command_for "$target")"
  lockfile="$(lockfile_for "$target")"
  local needs_install=0
  info "Checking dependencies..."
  if [[ -z "$lockfile" ]]; then
    info "No supported JS lockfile found; skipping dependency install."
  elif [[ -z "$install_cmd" ]]; then
    info "Found $lockfile, but matching package manager is not in PATH; skipping dependency install."
  elif [[ ! -d "$target/node_modules" ]]; then
    info "node_modules is missing; will run $install_cmd."
    needs_install=1
  elif [[ -n "$old_head" && -n "$lockfile" ]] && ! git -C "$target" diff --quiet "$old_head" HEAD -- "$lockfile" >/dev/null 2>&1; then
    info "$lockfile changed while reusing the slot; will run $install_cmd."
    needs_install=1
  else
    info "node_modules is present and lockfile did not change; skipping dependency install."
  fi

  if ((needs_install)); then
    info "Installing dependencies with $install_cmd..."
    run_logged_in_dir "Installing new dependencies..." \
      "$target" bash -c "$install_cmd"
  fi

  if ((branch_exists == 1)); then
    info "Checked out: $branch"
  else
    info "Allocated: $branch"
    info "Base:    $base_ref"
  fi
  info "Path:    $target"
  clear_worktree_rows_cache "$repo"
  if [[ "${WT_SHELL_INTEGRATION:-0}" == "1" ]]; then
    printf '__WT_ALLOCATED__\t%s\n' "$target"
  fi
}

cmd_alloc() {
  local repo="$1"
  shift
  local pool
  pool="$(pool_dir "$repo")"
  mkdir -p "$pool"

  local base_ref
  base_ref="$(default_base_ref "$repo")"
  local base_overridden=0
  local branch=""

  while (($#)); do
    case "$1" in
      --base)
        shift
        [[ $# -gt 0 ]] || die "--base requires a value"
        base_ref="$1"
        base_overridden=1
        ;;
      *)
        if [[ -z "$branch" ]]; then
          branch="$1"
        else
          die "Unexpected argument: $1"
        fi
        ;;
    esac
    shift
  done

  if [[ -z "$branch" ]]; then
    if [[ -t 0 ]]; then
      read -r -p "Branch name: " branch
    fi
  fi

  alloc_branch "$repo" "$pool" "$branch" "$base_ref" "$base_overridden" "" 0
}

cmd_realloc() {
  local repo="$1"
  shift
  local pool
  pool="$(pool_dir "$repo")"
  mkdir -p "$pool"

  local base_ref
  base_ref="$(default_base_ref "$repo")"
  local base_overridden=0
  local force=0
  local yes=0
  local query=""
  local branch=""

  while (($#)); do
    case "$1" in
      --base)
        shift
        [[ $# -gt 0 ]] || die "--base requires a value"
        base_ref="$1"
        base_overridden=1
        ;;
      --force|-f) force=1 ;;
      --yes|-y) yes=1 ;;
      *)
        if [[ -z "$query" ]]; then
          query="$1"
        elif [[ -z "$branch" ]]; then
          branch="$1"
        else
          die "Unexpected argument: $1"
        fi
        ;;
    esac
    shift
  done

  [[ -n "$query" ]] || die "Usage: wt realloc <worktree-query> [branch] [--base REF] [--force|-f] [--yes]"
  if [[ -z "$branch" ]]; then
    if [[ -t 0 ]]; then
      read -r -p "Branch name: " branch
    fi
  fi
  [[ -n "$branch" ]] || die "Branch name is required. Usage: wt realloc <worktree-query> <branch>"

  info "Realloc requested for worktree: $query"
  info "Target branch: $branch"
  info "Pool: $pool"
  info "Git hooks: $(hook_strategy "$repo")"

  if [[ "$query" == "main" || "$query" == "$repo" ]]; then
    die "'main' is the primary checkout and cannot be reallocated."
  fi

  local target
  target="$(pick_worktree_target "$repo" "$query")" || die "No worktree matches '$query'"
  [[ "$target" != "$repo" ]] || die "'main' is the primary checkout and cannot be reallocated."
  if is_free_slot_path "$target"; then
    die "Worktree is already free. Use wt alloc <branch> instead."
  fi
  info "Resolved worktree: $target"

  info "Checking worktree status..."
  ensure_clean_for_reuse \
    "$repo" \
    "$target" \
    "$force" \
    "Realloc anyway and discard these changes?" \
    "These changes will be permanently discarded before reallocating this worktree." || return 0

  if ((yes == 0)); then
    local answer
    if [[ -t 0 ]]; then
      read -r -p "Realloc $(basename "$target") ($target) to '$branch'? This detaches the current branch, moves/renames this worktree into the free pool, then renames it to the target branch. [y/N] " answer
      [[ "$answer" == [yY] || "$answer" == [yY][eE][sS] ]] || {
        info "Realloc cancelled."
        return 0
      }
    else
      die "Realloc requires confirmation. Re-run with --yes if intentional."
    fi
  fi

  if ! is_detached "$target"; then
    info "Detaching HEAD before reallocating this worktree."
    run_logged "Detaching selected worktree..." \
      git_wt "$repo" -C "$target" checkout --quiet --detach
  else
    info "HEAD is already detached."
  fi

  local slot
  slot="$(next_free_slot_path "$pool")"
  info "Moving selected worktree to temporary free slot: $slot"
  run_logged "Moving selected worktree to temporary free slot..." \
    git_wt "$repo" -C "$repo" worktree move "$target" "$slot"

  alloc_branch "$repo" "$pool" "$branch" "$base_ref" "$base_overridden" "$slot" 0
}

cmd_free() {
  local repo="$1"
  shift
  local pool
  pool="$(pool_dir "$repo")"
  mkdir -p "$pool"

  local force=0
  local query=""
  while (($#)); do
    case "$1" in
      --force|-f) force=1 ;;
      *) query="$1" ;;
    esac
    shift
  done
  [[ -n "$query" ]] || die "Usage: wt free <branch|worktree-query> [--force|-f]"
  info "Free requested for: $query"
  info "Pool: $pool"
  info "Git hooks: $(hook_strategy "$repo")"

  if [[ "$query" == "main" || "$query" == "$repo" ]]; then
    die "'main' is the primary checkout and is not part of the recyclable pool."
  fi

  local target
  target="$(pick_worktree_target "$repo" "$query")" || die "No worktree matches '$query'"
  info "Resolved worktree: $target"

  info "Checking worktree status..."
  ensure_clean_for_reuse \
    "$repo" \
    "$target" \
    "$force" \
    "Free anyway and discard these changes?" \
    "These changes will be permanently discarded before the worktree is returned to the free pool." || return 0

  if ! is_detached "$target"; then
    info "Detaching HEAD before returning worktree to pool."
    run_logged "Detaching worktree..." \
      git_wt "$repo" -C "$target" checkout --quiet --detach
  else
    info "HEAD is already detached."
  fi

  if is_free_slot_path "$target"; then
    info "Already free: $(basename "$target")"
    info "Path: $target"
    return 0
  fi

  local free_path
  free_path="$(next_free_slot_path "$pool")"
  if [[ "$target" != "$free_path" ]]; then
    info "Moving worktree to free slot: $free_path"
    run_logged "Moving worktree to free slot..." \
      git_wt "$repo" -C "$repo" worktree move "$target" "$free_path"
  fi

  info "Freed to: $(basename "$free_path")"
  info "Path: $free_path"
  clear_worktree_rows_cache "$repo"
  if [[ "${WT_SHELL_INTEGRATION:-0}" == "1" ]]; then
    printf '__WT_FREED__\t%s\t%s\n' "$target" "$free_path"
  fi
}

cmd_remove() {
  local repo="$1"
  shift

  local force=0
  local yes=0
  local query=""
  while (($#)); do
    case "$1" in
      --force|-f) force=1 ;;
      --yes|-y) yes=1 ;;
      *) query="$1" ;;
    esac
    shift
  done
  [[ -n "$query" ]] || die "Usage: wt remove <branch|worktree-query> [--force|-f] [--yes]"
  info "Remove requested for: $query"
  info "Git hooks: $(hook_strategy "$repo")"

  if [[ "$query" == "main" || "$query" == "$repo" ]]; then
    die "'main' is the primary checkout and cannot be removed by wt."
  fi

  local target
  target="$(pick_worktree_target "$repo" "$query")" || die "No worktree matches '$query'"
  info "Resolved worktree: $target"

  info "Checking worktree status..."
  if [[ -n "$(git -C "$target" status --porcelain)" && "$force" -ne 1 ]]; then
    die "Worktree has uncommitted changes. Commit/stash first, or use --force."
  fi
  if [[ -n "$(git -C "$target" status --porcelain)" ]]; then
    info "Worktree is dirty; --force was provided."
  else
    info "Worktree is clean."
  fi

  if ((yes == 0)); then
    local answer
    if [[ -t 0 ]]; then
      read -r -p "Remove $(basename "$target") ($target)? This deletes the worktree directory. [y/N] " answer
      [[ "$answer" == [yY] || "$answer" == [yY][eE][sS] ]] || {
        info "Remove cancelled."
        return 0
      }
    else
      die "Removal requires confirmation. Re-run with --yes if intentional."
    fi
  fi

  if ((force)); then
    info "Removing worktree with --force."
    run_logged "Removing worktree..." \
      git_wt "$repo" -C "$repo" worktree remove --force "$target"
  else
    info "Removing worktree."
    run_logged "Removing worktree..." \
      git_wt "$repo" -C "$repo" worktree remove "$target"
  fi
  info "Removed: $(basename "$target")"
  info "Path: $target"
  clear_worktree_rows_cache "$repo"
}

cmd_update() {
  local tmp raw_base
  tmp="$(mktemp -t wt-install.XXXXXX)"
  raw_base="$(repo_raw_base)"

  info "Downloading installer from: $raw_base/install.sh"
  download_file "$raw_base/install.sh" "$tmp"
  WT_REPO_RAW_BASE="$raw_base" bash "$tmp"
  rm -f "$tmp"
}

cmd_help() {
  cat <<'EOF'
wt - recycled git worktree pool helper

Usage:
  wt (interactive picker)
  wt grow [--size N] [--base REF] [--warm]
  wt alloc [branch] [--base REF]
  wt realloc <query> [branch] [--base REF] [--force|-f] [--yes]
  wt go <query> [--print-path]
  wt list
  wt free <query> [--force|-f]
  wt remove <query> [--force|-f] [--yes]
  wt update

Behavior:
  - grow: adds new detached free-N slots to the reusable pool.
  - alloc: uses a free worktree for a new/existing branch (new starts at remote default).
  - realloc: frees a selected worktree, then allocates a branch into that same slot.
  - free: detaches HEAD and renames worktree to smallest available free-N.
  - remove: deletes a pool worktree after confirmation; main is protected.
  - update: downloads the latest installer from GitHub and reinstalls wt.
  - go: prints a path normally; with shell integration, changes directory.
EOF
}

main() {
  local cmd="${1:-interactive}"
  if [[ $# -gt 0 ]]; then
    shift
  fi

  case "$cmd" in
    help|-h|--help) cmd_help; return 0 ;;
    update) cmd_update "$@"; return 0 ;;
  esac

  local repo
  repo="$(repo_root)"

  case "$cmd" in
    interactive) cmd_interactive "$repo" "$@" ;;
    grow) cmd_grow "$repo" "$@" ;;
    alloc) cmd_alloc "$repo" "$@" ;;
    realloc) cmd_realloc "$repo" "$@" ;;
    go) cmd_go "$repo" "$@" ;;
    list) cmd_list "$repo" "$@" ;;
    free) cmd_free "$repo" "$@" ;;
    remove) cmd_remove "$repo" "$@" ;;
    *) die "Unknown command: $cmd (run: wt help)" ;;
  esac
}

main "$@"
